# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ===== AZURE FOUNDRY / OPENAI TEXT / VISION / IMAGE GENERATION =====
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/openai/v1"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY"

# Deployment names as shown in Azure AI Foundry
TEXT_MODEL_DEPLOYMENT="gpt-4.1-mini"
VISION_MODEL_DEPLOYMENT="gpt-4.1-mini"
IMAGE_MODEL_DEPLOYMENT="FLUX-1.1-pro"

# ===== AZURE SPEECH =====
SPEECH_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
SPEECH_API_KEY="YOUR_SPEECH_API_KEY"
SPEECH_REGION="eastus"

# ===== AZURE CONTENT UNDERSTANDING =====
CONTENT_ENDPOINT="https://your-resource.services.ai.azure.com/"
CONTENT_API_KEY="YOUR_CONTENT_API_KEY"
CONTENT_API_VERSION="2025-11-01"

# ===== OPTIONAL PERSISTED FOUNDRY AGENT =====
FOUNDRY_PROJECT_ENDPOINT="https://your-resource.services.ai.azure.com/api/projects/your-project"
FOUNDRY_API_KEY="YOUR_FOUNDRY_API_KEY"
FOUNDRY_AGENT_ID="YOUR_AGENT_ID"
